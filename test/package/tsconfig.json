{
  // Resolves the packages like an app would (node_modules → package.json "exports" → dist/*.d.ts), with
  // skipLibCheck off, so incomplete or invalid published declarations fail. Run by `npm run check:package`
  // after `npm run build`. (No `paths` here, unlike test/tsconfig.json.)
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": false,
    "noEmit": true,
    "types": []
  },
  "files": ["consumer.ts"]
}
