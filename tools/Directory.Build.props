<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Exactly the runtime global.json's SDK ships with (Directory.Build.targets), so output doesn't vary by machine. -->
    <RollForward>Disable</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- App-local ICU, so culture data is identical on every OS. -->
    <IcuVersion>72.1.0.3</IcuVersion>
    <!-- After changing a package or NodaTimeRef, run `dotnet restore tools/NodaJs.Tools.slnx`: CI restores locked. -->
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
