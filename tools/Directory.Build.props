<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- The NodaTime tag we port from, and where tools/fetch-nodatime.* clones it. -->
    <NodaTimeTag>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)nodatime-version.txt').Trim())</NodaTimeTag>
    <NodaTimeRoot>$(MSBuildThisFileDirectory)../.nodatime/$(NodaTimeTag)/</NodaTimeRoot>
    <!-- Pin ICU so culture data is identical on every OS (app-local ICU instead of the system's). -->
    <IcuVersion>72.1.0.3</IcuVersion>
    <!-- Reproducible builds: deterministic compilation, packages.lock.json per project (restore fails in CI if
         the lock files are stale; re-run `dotnet restore tools/NodaJs.Tools.slnx` locally after changing a
         package or the NodaTime tag), and CI-normalised source paths. -->
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
