<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The test projects' Microsoft.Testing.Platform would add an entry point (CS7022). -->
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>
  
  <ItemGroup>
    <AssemblyMetadata Include="NodaTimeRef" Value="$(NodaTimeRef)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NodaTime.Serialization.SystemTextJson" />
    <PackageReference Include="System.CommandLine" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(NodaTimeRoot)src/NodaTime/NodaTime.csproj" />
    <ProjectReference Include="$(NodaTimeRoot)src/NodaTime.TzdbCompiler/NodaTime.TzdbCompiler.csproj" />
    <ProjectReference Include="$(NodaTimeRoot)src/NodaTime.Test/NodaTime.Test.csproj" 
                      SetTargetFramework="TargetFramework=$(TargetFramework)" />
    <ProjectReference Include="$(NodaTimeRoot)src/NodaTime.TzdbCompiler.Test/NodaTime.TzdbCompiler.Test.csproj" />
  </ItemGroup>

  <!-- Before restore walks the project references. -->
  <PropertyGroup>
    <NodaTimeStamp>$(NodaTimeRoot)noda-ports.stamp</NodaTimeStamp>
  </PropertyGroup>
  <Target Name="PrepareNodaTime" BeforeTargets="_GenerateRestoreProjectPathWalk"
          Inputs="$(MSBuildThisFileDirectory)../nodatime-ref.txt;$(MSBuildThisFileDirectory)../nuget.config"
          Outputs="$(NodaTimeStamp)">
    <Exec Condition="!Exists('$(NodaTimeRoot).git')"
          Command="git init --quiet &quot;$(NodaTimeRoot.TrimEnd('/'))&quot; &amp;&amp; git -C &quot;$(NodaTimeRoot.TrimEnd('/'))&quot; fetch --quiet --depth 1 https://github.com/nodatime/nodatime.git $(NodaTimeRef) &amp;&amp; git -C &quot;$(NodaTimeRoot.TrimEnd('/'))&quot; -c advice.detachedHead=false checkout --quiet FETCH_HEAD" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../nuget.config" DestinationFolder="$(NodaTimeRoot)" />
    <Touch Files="$(NodaTimeStamp)" AlwaysCreate="true" />
  </Target>
  <Target Name="EmbedNodaTimeHead" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git -C &quot;$(NodaTimeRoot.TrimEnd('/'))&quot; rev-parse HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="NodaTimeHead" />
    </Exec>
    <ItemGroup>
      <AssemblyMetadata Include="NodaTimeHead" Value="$(NodaTimeHead)" />
    </ItemGroup>
  </Target>
</Project>
