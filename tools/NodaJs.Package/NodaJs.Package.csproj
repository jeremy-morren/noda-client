<Project Sdk="Microsoft.NET.Sdk">
  <!-- No NodaTime, so release workflows build it without fetching NodaTime. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseAppLocalIcu>false</UseAppLocalIcu>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
</Project>
