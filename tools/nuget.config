<?xml version="1.0" encoding="utf-8"?>
<!-- Single package source, the NuGet API, with every package mapped to it. The tools use central package
     management (Directory.Packages.props), as does NodaTime, which rejects multiple sources without source
     mapping. NodaJs.Tools' PrepareNodaTime target also copies this file into the NodaTime clone. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
